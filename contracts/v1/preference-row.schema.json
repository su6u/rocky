{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocky.local/contracts/v1/preference-row.schema.json",
  "title": "Rocky reviewed preference row v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "category",
    "prompt",
    "chosen",
    "rejected",
    "failureModes",
    "provenance"
  ],
  "properties": {
    "schemaVersion": { "const": "rocky-preference-row-v1" },
    "id": { "type": "string", "pattern": "^pref-v1-[a-z0-9-]+$" },
    "category": { "type": "string", "minLength": 1 },
    "prompt": { "type": "string", "minLength": 1 },
    "chosen": { "$ref": "rocky-response.schema.json" },
    "rejected": { "$ref": "rocky-response.schema.json" },
    "failureModes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "provenance": { "$ref": "training-row.schema.json#/$defs/provenance" }
  }
}
