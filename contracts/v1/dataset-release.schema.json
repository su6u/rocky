{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocky.local/contracts/v1/dataset-release.schema.json",
  "title": "Rocky dataset release v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseId",
    "status",
    "createdAt",
    "corpusSha256",
    "datasetFiles",
    "rowCounts",
    "categoryShares",
    "checks",
    "approvals"
  ],
  "properties": {
    "schemaVersion": { "const": "rocky-dataset-release-v1" },
    "releaseId": { "type": "string", "pattern": "^rocky-data-v1-[a-z0-9-]+$" },
    "status": { "enum": ["blocked", "candidate", "approved"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "blockReason": { "type": "string", "minLength": 1 },
    "corpusSha256": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "datasetFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "sha256", "rowCount"],
        "properties": {
          "kind": {
            "enum": ["factCards", "sftSource", "sft", "preference", "golden", "interactive"]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$)).+$"
          },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "rowCount": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "rowCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sft", "preference", "golden", "interactive"],
      "properties": {
        "sft": { "type": "integer", "minimum": 0 },
        "preference": { "type": "integer", "minimum": 0 },
        "golden": { "type": "integer", "minimum": 0 },
        "interactive": { "type": "integer", "minimum": 0 }
      }
    },
    "categoryShares": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinaryConversation", "ordinaryHumorExpected", "movieCallbacks"],
      "properties": {
        "ordinaryConversation": { "type": "number", "minimum": 0, "maximum": 1 },
        "ordinaryHumorExpected": { "type": "number", "minimum": 0, "maximum": 1 },
        "movieCallbacks": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "provenance",
        "rights",
        "independentReview",
        "exactLeakage",
        "semanticLeakage",
        "distribution",
        "safety"
      ],
      "properties": {
        "schema": { "type": "boolean" },
        "provenance": { "type": "boolean" },
        "rights": { "type": "boolean" },
        "independentReview": { "type": "boolean" },
        "exactLeakage": { "type": "boolean" },
        "semanticLeakage": { "type": "boolean" },
        "distribution": { "type": "boolean" },
        "safety": { "type": "boolean" }
      }
    },
    "approvals": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reviewerId", "role", "approvedAt"],
        "properties": {
          "reviewerId": { "type": "string", "minLength": 1 },
          "role": { "enum": ["data", "canon", "rights", "safety"] },
          "approvedAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "approved" } } },
      "then": {
        "required": ["datasetFiles"],
        "properties": {
          "datasetFiles": { "minItems": 6 },
          "rowCounts": {
            "properties": {
              "sft": { "minimum": 3000 },
              "preference": { "minimum": 1200 },
              "golden": { "minimum": 300 },
              "interactive": { "minimum": 100 }
            }
          },
          "approvals": { "minItems": 4 },
          "corpusSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "categoryShares": {
            "properties": {
              "ordinaryConversation": { "minimum": 0.55, "maximum": 0.65 },
              "ordinaryHumorExpected": { "minimum": 0.6, "maximum": 0.7 },
              "movieCallbacks": { "minimum": 0.02, "maximum": 0.05 }
            }
          },
          "checks": {
            "properties": {
              "schema": { "const": true },
              "provenance": { "const": true },
              "rights": { "const": true },
              "independentReview": { "const": true },
              "exactLeakage": { "const": true },
              "semanticLeakage": { "const": true },
              "distribution": { "const": true },
              "safety": { "const": true }
            }
          }
        }
      }
    }
  ]
}
