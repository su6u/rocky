{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocky.local/contracts/v1/rocky-response.schema.json",
  "title": "Rocky response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["spoken", "emotion", "intensity", "gesture", "callbackId"],
  "properties": {
    "spoken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "emotion": {
      "enum": ["neutral", "excited", "alarmed", "sad", "happy", "curious"]
    },
    "intensity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "gesture": {
      "enum": [
        "none",
        "jazz_hands",
        "tap_carapace",
        "tap_divider",
        "point",
        "claw_on_divider",
        "fold_claws",
        "perk_up",
        "hunker_carapace",
        "raise_carapace",
        "sink_carapace",
        "shift_carapace",
        "cock_carapace",
        "wave_arms",
        "wave_absently",
        "bounce",
        "spider_walk",
        "skitter"
      ]
    },
    "callbackId": {
      "type": ["string", "null"],
      "pattern": "^callback-[a-z0-9-]+$"
    }
  }
}
